---
layout: layouts/page.liquid
---

<style>
    main {
        padding: 2em;
        font-family: "Alegreya Sans", sans-serif;
        max-width: 60em;
    }
    h1 {
        font-size: 3em;
        margin: 0;
    }
    h2 {
        font-size: 2.25rem;
        margin-top: 0;
        margin-bottom: 1rem;
        @media (width <=768px) {
            margin-top: 1rem;
        }
    }
    p {
        font-size: 1.3em;
        line-height: 1.5em;
    }
    figure {
        margin: 1em 0;
        align-items: flex-start;
        display: flex;
        @media (width >768px) {
            flex-direction: row;
        }
        @media (width <=768px) {
            flex-direction: column;
            padding-bottom: 1em;
            margin-bottom: 2em;
            border-bottom: 1px solid gray;
            &:last-of-type {
                border-bottom: none;
            }
        }
    }
    figure picture {
        display: block;
        flex-shrink: 0;
        @media (width >768px) {
            max-width: 50%;
            margin-right: 1em;
        }
        @media (width <=768px) {
            max-width: 100%;
        }
    }
    figure img {
        display: block;
        width: 100%;
        height: auto;
    }
    figcaption {
        font-size: 1.25em;
    }
</style>

{{ content }}
